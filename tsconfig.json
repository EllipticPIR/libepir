{
  // Node.js (N-API) build: emits CommonJS to ./dist.
  // The browser (WASM) sources use Web Workers with `import.meta.url` and are meant to be
  // consumed by a bundler directly from src_ts/, so they are type-checked by tsconfig.wasm.json instead.
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src_ts",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src_ts/**/*", "@types/**/*"],
  "exclude": ["dist", "build*", "src_ts/**/__tests__/**", "src_ts/wasm*.ts"]
}
