{
  // Type-checks the browser (WASM + Web Worker) sources. Nothing is emitted.
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "webworker"],
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src_ts/wasm*.ts", "@types/**/*"]
}
